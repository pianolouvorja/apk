library;

import 'dart:typed_data';

import 'package:dio/dio.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:louvorja_piano_mobile/data/datasources/remote/louvorja_api_impl.dart';

class _MockAdapter implements HttpClientAdapter {
  final dynamic Function(RequestOptions, int attempt) responder;
  int _attempt = 0;

  _MockAdapter(this.responder);

  @override
  void close({bool force = false}) {}

  @override
  Future<ResponseBody> fetch(
    RequestOptions options,
    Stream<List<int>>? requestStream,
    Future<void>? cancelFuture,
  ) async {
    final attempt = _attempt++;
    final result = responder(options, attempt);
    if (result is int && result >= 400) {
      throw DioException(
        requestOptions: options,
        response: Response(
          requestOptions: options,
          statusCode: result,
          headers: result == 429
              ? Headers.fromMap({'retry-after': ['1']})
              : null,
        ),
        type: DioExceptionType.badResponse,
      );
    }
    final json = result is String ? result : '[]';
    final bytes = Uint8List.fromList(json.codeUnits);
    return ResponseBody(Stream.fromIterable([bytes]), 200, headers: {
      Headers.contentTypeHeader: ['application/json'],
    });
  }
}

LouvorjaApiImpl _api(_MockAdapter adapter) {
  final api = LouvorjaApiImpl(
    baseUrl: 'https://api.example.com/json_db',
    filesUrl: 'https://api.example.com/file',
    apiToken: 'token',
    languagePrefix: 'pt',
    now: () => DateTime(2026, 8, 10),
  );
  api.dio.httpClientAdapter = adapter;
  return api;
}

void main() {
  test('retry 429 com Retry-After eventualmente sucede', () async {
    final api = _api(_MockAdapter((req, attempt) {
      if (attempt < 1) return 429;
      return '[]';
    }));

    final result = await api.fetchCategories();
    expect(result, isEmpty);
  });

  test('retry 500 eventualmente sucede', () async {
    final api = _api(_MockAdapter((req, attempt) {
      if (attempt < 1) return 500;
      return '[{"id_category":1,"name":"OK","albums":[]}]';
    }));

    final result = await api.fetchCategories();
    expect(result.length, 1);
  });

  test('429 apos max retries lanca serverBusy', () async {
    final api = _api(_MockAdapter((req, attempt) => 429));

    expect(
      () => api.fetchCategories(),
      throwsA(predicate((e) =>
          e is LouvorjaApiException && e.code == 'errors.serverBusy')),
    );
  });

  test('500 apos max retries lanca serverBusy', () async {
    final api = _api(_MockAdapter((req, attempt) => 503));

    expect(
      () => api.fetchCategories(),
      throwsA(predicate((e) =>
          e is LouvorjaApiException && e.code == 'errors.serverBusy')),
    );
  });

  test('erro 400 lanca connection', () async {
    final api = _api(_MockAdapter((req, attempt) => 400));

    expect(
      () => api.fetchCategories(),
      throwsA(predicate((e) =>
          e is LouvorjaApiException && e.code == 'errors.connection')),
    );
  });

  test('response.data como string e decodificado', () async {
    final api = _api(_MockAdapter((req, attempt) {
      return '[{"id_category":1,"name":"Str","albums":[]}]';
    }));

    final result = await api.fetchCategories();
    expect(result[0].name, 'Str');
  });
}
